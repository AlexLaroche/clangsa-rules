{
  "name": "freerdp-clear-vbar-size-before-realloc",
  "cve": "CVE-2026-33984",
  "repo": "https://github.com/FreeRDP/FreeRDP.git",
  "vulnerable": "f6e43e208958140074ae9bb93cd0c9045a371c77",
  "fixed": "dc7fdb165095139be779a4000199bc1706b06ad5",
  "fixed_note": "[codec,clear] update the vBar entry size after the reallocation succeeded",
  "setup": [
    [
      "cmake",
      "-S",
      ".",
      "-B",
      "build-raptor",
      "-G",
      "Ninja",
      "-DWITH_CLIENT=OFF",
      "-DWITH_SERVER=OFF",
      "-DWITH_SAMPLE=OFF",
      "-DWITH_X11=OFF",
      "-DWITH_WAYLAND=OFF",
      "-DWITH_FFMPEG=OFF",
      "-DWITH_SWSCALE=OFF",
      "-DWITH_CUPS=OFF",
      "-DWITH_PULSE=OFF",
      "-DWITH_ALSA=OFF",
      "-DWITH_FUSE=OFF",
      "-DWITH_PCSC=OFF",
      "-DWITH_KRB5=OFF",
      "-DWITH_CHANNELS=OFF",
      "-DWITH_MANPAGES=OFF",
      "-DWITH_JSON_DISABLED=ON",
      "-DWITH_CLIENT_SDL=OFF",
      "-DWITH_SHADOW=OFF",
      "-DWITH_PROXY=OFF",
      "-DWITH_PLATFORM_SERVER=OFF",
      "-DWITH_OPUS=OFF",
      "-DWITH_LAME=OFF",
      "-DWITH_FAAD2=OFF",
      "-DWITH_FAAC=OFF",
      "-DWITH_SOXR=OFF",
      "-DWITH_WEBVIEW=OFF",
      "-DWITH_DSP_FFMPEG=OFF",
      "-DWITH_URIPARSER=OFF",
      "-DWITH_AAD=OFF"
    ]
  ],
  "checker": "raptor.CapacityUpdatedBeforeRealloc",
  "args": [
    "-std=gnu11",
    "-Iinclude",
    "-Iwinpr/include",
    "-Ibuild-raptor/include",
    "-Ibuild-raptor/winpr/include",
    "-Ilibfreerdp",
    "-Ibuild-raptor/libfreerdp",
    "-Ilibfreerdp/codec"
  ],
  "files": {
    "libfreerdp/codec/clear.c": [
      "^\\t\\tvBarEntry->size = vBarEntry->count;$"
    ]
  }
}
