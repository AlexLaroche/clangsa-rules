{
  "name": "libde265-image-plane-alloc",
  "cve": "CVE-2026-49346",
  "repo": "https://github.com/strukturag/libde265.git",
  "vulnerable": "56fb7b8f79ebdf0e11073fedc40a476215e6170a",
  "fixed": "8a1b5cf212f78e1c77cb46eb5d56e492a9336eb8",
  "fixed_note": "fix integer overflow in image plane allocation size (GHSA-vv8h-932h-7r86)",
  "setup": [
    [
      "cmake",
      "-S",
      ".",
      "-B",
      "build-raptor",
      "-DENABLE_DECODER=OFF",
      "-DENABLE_ENCODER=OFF"
    ]
  ],
  "checker": "raptor.UncheckedAllocProduct",
  "args": [
    "-std=c++11",
    "-DHAVE_CONFIG_H",
    "-I.",
    "-Ilibde265",
    "-Ibuild-raptor",
    "-Ibuild-raptor/libde265"
  ],
  "files": {
    "libde265/image.cc": {
      "vulnerable": [
        "ALLOC_ALIGNED_16\\(stride \\* height \\+ MEMORY_PADDING\\)",
        "ALLOC_ALIGNED_16\\(luma_height   \\* luma_bpl   \\+ MEMORY_PADDING\\)",
        {
          "re": "ALLOC_ALIGNED_16\\(chroma_height \\* chroma_bpl \\+ MEMORY_PADDING\\)",
          "count": 2
        }
      ],
      "fixed": [
        "ALLOC_ALIGNED_16\\(static_cast<size_t>\\(stride\\) \\* height",
        "ALLOC_ALIGNED_16\\(static_cast<size_t>\\(luma_height\\) \\* luma_bpl",
        {
          "re": "ALLOC_ALIGNED_16\\(static_cast<size_t>\\(chroma_height\\) \\* chroma_bpl",
          "count": 2
        }
      ]
    }
  }
}
