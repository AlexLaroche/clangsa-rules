      "--branch",
      "v6.5.2.202603_rel",
      "https://github.com/eclipse-threadx/threadx.git",
      "raptor-threadx"
    ],
    [
      "git",
      "clone",
      "-q",
      "--depth",
      "1",
      "--branch",
      "v6.5.2.202603_rel",
      "https://github.com/eclipse-threadx/filex.git",
      "raptor-filex"
    ]
  ],
  "checker": "raptor.UncheckedLengthDifference",
  "args": [
    "-Icommon/inc",
    "-Iports/linux/gnu/inc",
    "-Iraptor-threadx/common/inc",
    "-Iraptor-threadx/ports/linux/gnu/inc",
    "-Iraptor-filex/common/inc",
    "-Iraptor-filex/ports/linux/gnu/inc",
    "-Iaddons/http"
  ],
  "sparse": [
    "common",
    "addons/http",
    "ports/linux"
  ],
  "files": {
