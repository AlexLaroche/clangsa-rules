  "checker": "raptor.DoubleFree",
  "args": [
    "-std=gnu11",
    "-DMONGOC_COMPILATION",
    "-DBSON_COMPILATION",
    "-Isrc/libmongoc/src",
    "-Isrc/libbson/src",
    "-Isrc/common/src",
    "-Ibuild-raptor/src/libmongoc/src",
    "-Ibuild-raptor/src/libbson/src",
    "-Ibuild-raptor/src/common/src",
    "-Ibuild-raptor/src/libmongoc/src/mongoc",
