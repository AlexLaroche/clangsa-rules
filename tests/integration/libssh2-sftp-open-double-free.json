{
  "name": "libssh2-sftp-open-double-free",
  "cve": "CVE-2026-66032",
  "repo": "https://github.com/libssh2/libssh2.git",
  "vulnerable": "f784c21decebbb323c6165de75de9fe0c6c83531",
  "fixed": "5e4776146552d898b9c0e1b313cd093fa8dc92d0",
  "fixed_note": "sftp: clear data after freeing it in sftp_open() so a failed sftp_packet_require() does not free it again",
  "checker": "raptor.DoubleFree",
  "args": [
    "-Iinclude",
    "-Isrc",
    "-DLIBSSH2_OPENSSL",
    "-DHAVE_UNISTD_H",
    "-DHAVE_INTTYPES_H",
    "-DHAVE_STDLIB_H",
    "-DHAVE_SYS_SELECT_H",
    "-DHAVE_SYS_UIO_H",
    "-DHAVE_SYS_SOCKET_H",
    "-DHAVE_SYS_TIME_H",
    "-DHAVE_O_NONBLOCK"
  ],
  "files": {
    "src/sftp.c": [
      {
        "re": "^                SSH2_FREE\\(session, data\\);$",
        "after": "\"Failed opening remote file\""
      }
    ]
  }
}
